# Скопируй в .env.local и подставь ключи. .env.local в git не коммитим.

# https://app.slng.ai/projects → New project → Generate key (показывается один раз)
SLNG_API_KEY=slng_cu_...

# Свободные реплики. Нужен и для прямого пути, и для BYOK через Context Router.
ANTHROPIC_API_KEY=sk-ant-...

# Регион. Полный список: docs.slng.ai/guides/regions/regions-map
SLNG_REGION=eu-west

# Модели. Живой список: curl localhost:5179/api/slng/catalog
# По HTTP в eu-west работают только прямые эндпоинты /v1/{tts,stt}/{model};
# unified /v1/bridges/unmute/... отвечает 405 — он WebSocket-only.
SLNG_STT=deepgram/nova:3
SLNG_TTS=deepgram/aura:2
SLNG_TTS_VOICE=aura-2-javier-es

# direct — свободные реплики прямо в Anthropic (fast mode + кэш работают)
# router — через SLNG Context Router (проверка §11: что проходит, что нет)
LQ_LLM_ROUTE=direct
LQ_MODEL=claude-opus-5
SLNG_AGENT_ID=caperucita-v1

# fal.ai — генерация картинок: node tools/gen-image.mjs "<промпт>" out.png
# https://fal.ai/dashboard/keys
FAL_KEY=
